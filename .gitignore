# ── Dependencies ───────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Environment Variables (NEVER commit real secrets) ──────────
# Commit .env.example files only — not .env or .env.local
.env
.env.local
.env.development
.env.production
.env.development.local
.env.test.local
.env.production.local

# ── Build Artefacts ────────────────────────────────────────────
.next/
dist/
build/
out/

# ── Cache ──────────────────────────────────────────────────────
.cache/
.eslintcache
*.tsbuildinfo

# ── Logs ───────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── OS Files ───────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp

# ── IDE ────────────────────────────────────────────────────────
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Testing / Coverage ─────────────────────────────────────────
coverage/

# ── Deployment ────────────────────────────────────────────────
.vercel/
.render/

# ── Monorepo root — no lock file here ─────────────────────────
