# =================================================================
# PORTFOLIO FRONTEND — ENVIRONMENT VARIABLES
# =================================================================
# Copy this file to .env.local for local development.
# In production (Vercel), add each variable in:
#   Project → Settings → Environment Variables
#
# NEVER commit .env.local to git.
# =================================================================

# ── Backend API (Next.js requires NEXT_PUBLIC_ for browser access) ─
NEXT_PUBLIC_API_URL=https://your-backend.onrender.com/api
NEXT_PUBLIC_BACKEND_URL=https://your-backend.onrender.com
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# ── Cloudinary (image delivery, public — no secrets here) ─────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=portfolio_uploads
