# =============================================================
# PORTFOLIO FRONTEND — ENVIRONMENT VARIABLES
# =============================================================
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local to git.
#
# How to get these values:
#   Supabase  → https://app.supabase.com > Your Project > Settings > API
#   Cloudinary→ https://console.cloudinary.com > Dashboard

# ── Backend API ──────────────────────────────────────────────
# URL of your deployed Express backend (Render, Railway, etc.)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# ── Site URL (used for OAuth redirects & OG meta) ────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (optional — only if using Supabase client directly) ──
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── OpenGraph Image ───────────────────────────────────────────
# Absolute URL to the social-preview image (1200×630px)
NEXT_PUBLIC_OG_IMAGE_URL=https://your-domain.com/og-image.png
